# Copy to .env and change the values:
#   cp .env.example .env   (Linux/macOS/WSL)
#   copy .env.example .env (Windows cmd / PowerShell)
#   chmod 600 .env         (Linux/macOS/WSL)
#
# Do that chmod. This file holds the Shadowsocks password, the group password
# and the node addresses, and on a multi-user host a world-readable copy of it
# is enough to impersonate the client node and to use the exit. On Windows:
#   icacls .env /inheritance:r /grant:r "%USERNAME%:R"
#
# Every value is read by both docker-compose.yml (server) and
# docker-compose.client.yml (client). The client additionally needs
# YGG_SERVER_ADDR, the server additionally needs YGG_CLIENT_ADDR, see the bottom
# of this file.
#
# IMPORTANT: this file is consumed by Docker Compose interpolation, and the
# values end up verbatim in command-line arguments (-k) and in an HJSON config
# file. Avoid the characters $, " and \ in SS_PASSWORD and YGG_GROUP_PASSWORD.
# The entrypoint does escape " \ & | when it renders the config, but $ is
# consumed by Compose before the container ever sees it.
#
# Nothing here checks the strength of the two passwords. A value that is still
# a placeholder, or a short memorable one, produces two perfectly healthy nodes
# and a proxy with no meaningful authentication.

# ---------------------------------------------------------------------------
# Shadowsocks
# ---------------------------------------------------------------------------

# Encryption method (aes-128-gcm, aes-256-gcm, chacha20-ietf-poly1305, ...).
# Must match on both sides.
SS_METHOD=aes-256-gcm

# Shadowsocks password. This is the only thing standing between the exit and
# anybody who learns the server's Yggdrasil address, and it has to be long
# enough that guessing is hopeless rather than merely unlikely: every relay node
# on the path sees the encrypted Shadowsocks handshake and can try candidate
# passwords against it offline, with no rate limit and no trace left anywhere.
#
#   openssl rand -base64 32
#
# Anything under about 24 random characters, and anything you can remember or
# type from memory, should be treated as no authentication at all.
SS_PASSWORD=ChangeMe_strong_password

# Port that ssserver binds to ON THE YGGDRASIL ADDRESS, i.e. it listens on
# [200:...::]:8388 inside the shared network namespace. Never exposed to the
# clearnet, no port publishing. Both sides must match.
SS_SERVER_PORT=8388

# SOCKS5 port published to the host on the CLIENT (docker-compose.client.yml).
SS_LOCAL_PORT=1080

# Docker image tag for the shadowsocks-rust client/server binaries.
SS_IMAGE_TAG=v1.25.0

# ---------------------------------------------------------------------------
# Yggdrasil
# ---------------------------------------------------------------------------

# Yggdrasil release to build our pinned image from.
# https://github.com/yggdrasil-network/yggdrasil-go/releases
YGG_VERSION=0.5.14

# Closed-overlay password (Yggdrasil v0.5.14+). Session traffic is only
# exchanged between nodes that share this value, so no other node on the public
# network can reach the server's Shadowsocks port even if it learns the
# server's address. Use the SAME value on both sides: a mismatch gives two
# perfectly healthy, peered nodes that cannot talk, which is very hard to debug.
# Peering and third-party relaying are not affected.
#
# Like the Shadowsocks password it has to be unguessable, and for the same
# reason: Yggdrasil derives SHA256("ironwood/encrypted\0" || password) and uses
# that as the preimage of the session handshake signature, so a node that
# captured a handshake can check a guess against a known public key without ever
# touching the server.
#
#   openssl rand -hex 24
YGG_GROUP_PASSWORD=ChangeMe_group_password

# Outbound peering connections, comma separated. The node needs peers to join
# the network; it finds the server through the DHT, so both sides peer with
# public nodes only and never with each other.
#
# This is the one variable here with NO DEFAULT, and it cannot be left empty:
# a node with no peers cannot join the network at all, so the tunnel would
# never come up. Compose refuses to start while the value is empty ("required
# variable YGG_PEERS is missing a value"), which turns a silent dead node into
# a one-second error that names the variable. Fill it in before the first
# `docker compose up -d`.
#
# Take two or three LIVE connection strings from
# https://publicpeers.neilalexander.dev/ and paste them here unmodified, comma
# separated, with the scheme the list gives you:
#
#   YGG_PEERS=tls://a.example.org:1338?key=00000000...b9be63ce693e18a,tls://b.example.org:1338?key=000000d8...1e4644ae
#
# A longer list can be wrapped in double quotes and broken over several lines;
# whitespace is stripped before the list is rendered into the config. The server
# and the client do not need the same list — each node only needs a peer or two
# of its own.
#
# IMPORTANT: peer only with nodes that are GEOGRAPHICALLY CLOSE. Latency and
# throughput of the whole tunnel depend on the first hop, and a distant peer
# also means your node carries traffic for the rest of the network.
#
# A peer that only has an AAAA record cannot be reached from a container on a
# host without IPv6 connectivity and shows up as "connect: network is
# unreachable" in the node log; drop such peers or give the host IPv6. It is
# noise, not a failure: two or three peers in state Up is enough.
YGG_PEERS=

# MTU of the Yggdrasil TUN interface. 65535 is the upstream default and
# Yggdrasil handles segmentation on its own, so there is rarely a reason to
# change this. Lower it to 1280 if your network path blackholes large frames.
YGG_IF_MTU=65535

# ---------------------------------------------------------------------------
# Client only
# ---------------------------------------------------------------------------

# Yggdrasil IPv6 address of the SERVER node, without brackets, e.g.
# 200:1a2b:3c4d:5e6f:7a8b:9abc:def0:1234. It is printed in full, not in the
# compressed "::" form. On the server run:  ./scripts/get-server-address.sh
YGG_SERVER_ADDR=REPLACE_WITH_SERVER_ADDRESS

# ---------------------------------------------------------------------------
# Server only
# ---------------------------------------------------------------------------

# Who may reach the Shadowsocks port on the overlay. Three forms:
#
#   YGG_CLIENT_ADDR=any
#       No firewall filter. Every node that knows both passwords can use the
#       proxy; the server logs a notice saying so. Choose this on purpose, for
#       example when the client address is not known in advance or it keeps
#       changing.
#
#   YGG_CLIENT_ADDR=201:1a2b:3c4d:5e6f:7a8b:9abc:def0:1234
#   YGG_CLIENT_ADDR=201:1a2b:...,202:1a2b:...
#       Install one ip6tables accept rule per address, plus a drop rule for
#       everything else on the port. This is the layer that does not depend on
#       anybody having picked a strong group password. Spaces around the commas
#       are ignored, so the list can be aligned over several lines. Every
#       address is checked before a single rule is installed, so one typo stops
#       the server instead of leaving a filter that accepts nobody.
#       Get the addresses on the client with:
#
#         COMPOSE_FILE=docker-compose.client.yml ./scripts/get-server-address.sh
#
# Leaving the value empty is an error and the server will not start. That is
# deliberate: an empty value used to mean "no filter", which made a deleted or
# forgotten line indistinguishable from a deliberate decision to leave the port
# open. If you want it open, say so.
#
# If you recreate a client's state volume its address changes and you have to
# update it here and restart the server, exactly like YGG_SERVER_ADDR on the
# client. With `any` in place that stops being a problem, at the cost of the
# firewall layer.
YGG_CLIENT_ADDR=any
